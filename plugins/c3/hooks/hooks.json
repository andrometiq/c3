{
  "description": "C3 hooks — SessionStart records the stable --resume session id (c3-broker session-hook) so a resumed session auto-attaches to its last Telegram topic. PermissionDenied and PreToolUse carry Telegram approval of auto-mode denials; both are silent unless auto_mode_approval is enabled.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "c3-broker session-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "c3-broker pretooluse-hook || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "c3-broker permission-denied-hook || exit 0",
            "timeout": 330
          }
        ]
      }
    ]
  }
}
